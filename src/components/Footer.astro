---
import Mark from "./Mark.astro";
const year = new Date().getFullYear();
---
<footer class="relative border-t border-[var(--color-hairline)] bg-[var(--color-void)]">
  <div class="mx-auto max-w-[1200px] px-6 lg:px-10 py-14 grid grid-cols-1 md:grid-cols-[1.3fr_1fr_1fr] gap-12">
    <div>
      <a href="/" class="flex items-center gap-3 mb-4">
        <Mark size={28} />
        <span class="font-display text-[15px] text-[var(--color-ink)]">Polovina Scientific</span>
      </a>
      <p class="text-[13.5px] text-[var(--color-ink-faint)] leading-relaxed max-w-[320px]">
        Independent scientific and financial diligence on cell &amp; gene therapy assets, built for capital allocators.
      </p>
    </div>

    <div>
      <div class="font-mono text-[10px] tracking-[0.18em] uppercase text-[var(--color-ink-faint)] mb-4">Navigate</div>
      <ul class="flex flex-col gap-2.5">
        <li><a href="/" class="text-[13.5px] text-[var(--color-ink-dim)] hover:text-[var(--color-signal)] transition-colors">Home</a></li>
        <li><a href="/capabilities" class="text-[13.5px] text-[var(--color-ink-dim)] hover:text-[var(--color-signal)] transition-colors">Capabilities</a></li>
        <li><a href="/about" class="text-[13.5px] text-[var(--color-ink-dim)] hover:text-[var(--color-signal)] transition-colors">About</a></li>
        <li><a href="/contact" class="text-[13.5px] text-[var(--color-ink-dim)] hover:text-[var(--color-signal)] transition-colors">Contact</a></li>
      </ul>
    </div>

    <div>
      <div class="font-mono text-[10px] tracking-[0.18em] uppercase text-[var(--color-ink-faint)] mb-4">Direct</div>
      <a href="mailto:elias.polovina@polovinascientific.com" class="text-[13.5px] text-[var(--color-ink-dim)] hover:text-[var(--color-signal)] transition-colors break-all">
        elias.polovina@polovinascientific.com
      </a>
    </div>
  </div>

  <div class="border-t border-[var(--color-hairline)]">
    <div class="mx-auto max-w-[1200px] px-6 lg:px-10 py-5 flex flex-col sm:flex-row items-center justify-between gap-3">
      <span class="font-mono text-[10px] tracking-[0.1em] text-[var(--color-ink-faint)]">© {year} Polovina Scientific Advisory LLC</span>
      <span class="font-mono text-[10px] tracking-[0.1em] text-[var(--color-ink-faint)]">Independent diligence. No platform or vendor affiliation.</span>
    </div>
  </div>
</footer>
