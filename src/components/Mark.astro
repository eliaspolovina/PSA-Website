---
interface Props {
  size?: number;
  class?: string;
}
const { size = 36, class: className = "" } = Astro.props;
---
<!-- Brand mark: a helix-derived signal trace inside a hairline ring — science (the helix)
     resolving into a clean data read (the trace), a generic placeholder until a final mark exists. -->
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <circle cx="20" cy="20" r="19" stroke="var(--color-hairline-bright)" stroke-width="1" />
  <path
    d="M9 26C9 26 13 14 20 14C27 14 31 26 31 26"
    stroke="var(--color-ink-dim)"
    stroke-width="1.1"
    stroke-linecap="round"
    opacity="0.55"
  />
  <path
    d="M9 22C12.5 22 13 13 20 13C27 13 27.5 27 31 27"
    stroke="var(--color-signal)"
    stroke-width="1.4"
    stroke-linecap="round"
  />
  <circle cx="31" cy="27" r="2" fill="var(--color-signal)" />
</svg>
