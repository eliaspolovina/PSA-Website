---
interface Props {
  size?: number;
  class?: string;
}
const { size = 36, class: className = "" } = Astro.props;
---
<!--
  Brand mark: PSA logo with white background removed (transparent PNG).
  CSS filter shifts the navy ink to the site's signal-green (#34e0c4).
-->
<img
  class={className}
  src="data:image/png;base64,"
  width={size}
  height={size}
  alt="Polovina Scientific Advisory"
  style={`
    width: ${size}px;
    height: ${size}px;
    object-fit: contain;
    filter:
      brightness(0)
      saturate(100%)
      invert(1)
      sepia(1)
      saturate(3)
      hue-rotate(130deg)
      brightness(1.1);
  `}
  aria-hidden="true"
/>
