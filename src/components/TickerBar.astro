---
const SYMBOLS = [
  { sym: "REGN",  name: "Regeneron"             },
  { sym: "VRTX",  name: "Vertex Pharma"         },
  { sym: "MRNA",  name: "Moderna"               },
  { sym: "BMRN",  name: "BioMarin"              },
  { sym: "CRSP",  name: "CRISPR Therapeutics"   },
  { sym: "NTLA",  name: "Intellia"              },
  { sym: "BEAM",  name: "Beam Therapeutics"     },
  { sym: "RARE",  name: "Ultragenyx"            },
  { sym: "ALNY",  name: "Alnylam"               },
  { sym: "IONS",  name: "Ionis Pharma"          },
  { sym: "SRPT",  name: "Sarepta"               },
  { sym: "RCKT",  name: "Rocket Pharma"         },
  { sym: "ACAD",  name: "ACADIA Pharma"         },
  { sym: "PTGX",  name: "Protagonist Therap."   },
  { sym: "KYMR",  name: "Kymera Therap."        },
  { sym: "IOVA",  name: "Iovance Biotherapeutics"},
  { sym: "MNPR",  name: "Monopar Therapeutics"  },
  { sym: "REPL",  name: "Replimune"             },
];
const nameMap = JSON.stringify(Object.fromEntries(SYMBOLS.map(s => [s.sym, s.name])));
const syms = SYMBOLS.map(s => s.sym);
---

<div class="psa-ticker-wrap" data-names={nameMap}>
  <!-- fade edges -->
  <div class="psa-fade-left"></div>
  <div class="psa-fade-right"></div>
  <!-- single scrolling track -->
  <div class="psa-ticker-track" id="psa-ticker-track">
    {[...SYMBOLS, ...SYMBOLS].map((t) => (
      <span class="psa-ticker-item">
        <span class="psa-sym">{t.sym}</span>
        <span class="psa-name">{t.name}</span>
        <span class="psa-price">—</span>
        <span class="psa-pct">—</span>
      </span>
    ))}
  </div>
</div>

<style>
  .psa-ticker-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-top: 1px solid rgba(151,196,214,0.14);
    border-bottom: 1px solid rgba(151,196,214,0.14);
    background: var(--color-void);
    padding: 9px 0;
  }
  .psa-fade-left, .psa-fade-right {
    position: absolute;
    top: 0; bottom: 0;
    width: 64px;
    z-index: 2;
    pointer-events: none;
  }
  .psa-fade-left  { left: 0;  background: linear-gradient(to right, var(--color-void), transparent); }
  .psa-fade-right { right: 0; background: linear-gradient(to left,  var(--color-void), transparent); }

  .psa-ticker-track {
    display: inline-flex;
    flex-wrap: nowrap;
    white-space: nowrap;
    animation: psa-scroll 90s linear infinite;
    will-change: transform;
  }
  .psa-ticker-wrap:hover .psa-ticker-track {
    animation-play-state: paused;
  }
  .psa-ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 0 24px;
    border-right: 1px solid rgba(151,196,214,0.14);
    flex-shrink: 0;
  }
  .psa-sym   { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; font-weight: 500; color: var(--color-ink); }
  .psa-name  { font-family: var(--font-mono); font-size: 10px; color: var(--color-ink-faint); }
  .psa-price { font-family: var(--font-mono); font-size: 11px; color: var(--color-ink-faint); }
  .psa-pct   { font-family: var(--font-mono); font-size: 10px; color: var(--color-ink-faint); }

  @keyframes psa-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
</style>

<script>
  (async () => {
    const wrap  = document.querySelector(".psa-ticker-wrap") as HTMLElement | null;
    const track = document.getElementById("psa-ticker-track");
    if (!wrap || !track) return;

    const nameMap = JSON.parse(wrap.dataset.names!) as Record<string, string>;
    const syms    = Object.keys(nameMap);
    const green   = "#34e0c4";
    const red     = "#f87171";

    const update = (tickers: Array<{ sym: string; price: string; pct: string; up: boolean | null }>) => {
      const dataMap = Object.fromEntries(tickers.map(t => [t.sym, t]));
      const items   = track!.querySelectorAll(".psa-ticker-item");
      items.forEach((item, i) => {
        const sym   = syms[i % syms.length];
        const d     = dataMap[sym];
        const col   = !d || d.up === null ? "var(--color-ink-faint)" : d.up ? green : red;
        const priceEl = item.querySelector(".psa-price") as HTMLElement;
        const pctEl   = item.querySelector(".psa-pct")   as HTMLElement;
        if (priceEl) { priceEl.textContent = d?.price ?? "—"; priceEl.style.color = col; }
        if (pctEl)   { pctEl.textContent   = d?.pct   ?? "—"; pctEl.style.color   = col; }
      });
    };

    const load = async () => {
      try {
        const res  = await fetch("/api/tickers");
        const json = await res.json() as { tickers?: Array<{ sym: string; price: string; pct: string; up: boolean | null }> };
        if (json.tickers?.length) update(json.tickers);
      } catch (e) {
        console.warn("Ticker fetch failed:", e);
      }
    };

    await load();
    setInterval(load, 60_000);
  })();
</script>
