---
import Layout from "../layouts/Layout.astro";

const domains = [
  {
    num: "01",
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-7 h-7"><circle cx="14" cy="14" r="9" stroke="currentColor" stroke-width="1.2"/><path d="M14 8v6l4 2.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><circle cx="14" cy="14" r="2" fill="currentColor" opacity="0.3"/></svg>`,
    name: "Clinical Probability of Success",
    summary: "Independent read on whether a trial is designed to succeed — or to impress.",
    tags: ["Endpoint & Trial Design", "Regulatory Pathway", "Competitor Read-Through", "Catalyst Timeline", "Enrollment Feasibility", "Historical Benchmarking"],
  },
  {
    num: "02",
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-7 h-7"><rect x="5" y="5" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.2"/><path d="M9 14h10M9 10h6M9 18h8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>`,
    name: "Technical Feasibility",
    summary: "Whether the science and manufacturing can actually deliver what the deck promises.",
    tags: ["Platform Plausibility", "CMC & Scalability", "Safety Signal Read", "Durability of Effect", "Process Risk", "Freedom-to-Operate"],
  },
  {
    num: "03",
    icon: `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-7 h-7"><path d="M6 20l5-6 4 3 5-9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="22" cy="8" r="2" fill="currentColor" opacity="0.5"/></svg>`,
    name: "Financial & Commercial Outlook",
    summary: "A scientific win is not automatically a financial one. We size the real math.",
    tags: ["Population Sizing", "Pricing & Reimbursement", "Capital Runway", "Competitive Crowding", "Catalyst Realism", "M&A Optionality"],
  },
];

const formats = [
  { title: "Single-Name Deep Dive", desc: "A full clinical, technical, and financial read on one asset or company ahead of a position, catalyst, or LP decision." },
  { title: "Pre-Deal / Crossover Screen", desc: "A faster, focused read timed to a financing round, IPO window, or PIPE — built for a decision that can't wait." },
  { title: "Portfolio Monitoring", desc: "Ongoing coverage of names already in a book, with flags raised as new data or regulatory action changes the picture." },
  { title: "Expert Call / Second Opinion", desc: "A direct conversation to pressure-test a thesis, a sell-side note, or management's framing before a decision is finalized." },
];
---
<Layout title="Capabilities">
  <!-- HERO -->
  <section class="px-6 lg:px-10 pt-16 pb-14 lg:pt-20 border-b border-[var(--color-hairline)]">
    <div class="mx-auto max-w-[1200px] grid lg:grid-cols-[1fr_1.2fr] gap-12 items-end">
      <div>
        <div class="eyebrow mb-4"><span class="kicker-line"></span>Capabilities</div>
        <h1 class="font-display text-[clamp(2.1rem,3.4vw,3rem)] text-[var(--color-ink)] leading-[1.15]">
          Diligence built around<br/>the decision in front of you.
        </h1>
      </div>
      <p class="text-[15px] text-[var(--color-ink-dim)] font-light leading-[1.85]">
        Biotechnology investing demands reading clinical, technical, and financial signals simultaneously.
        Our work is organized around the three questions that actually determine whether a position works.
      </p>
    </div>
  </section>

  <!-- DOMAINS — card grid, minimal text -->
  <section class="px-6 lg:px-10 py-20">
    <div class="mx-auto max-w-[1200px] grid md:grid-cols-3 gap-4">
      {domains.map((d) => (
        <div class="glass rounded-[6px] p-8 flex flex-col gap-6 group hover:border-[var(--color-signal-line)] transition-colors">
          <div class="flex items-start justify-between">
            <div class="w-12 h-12 rounded-[4px] bg-[var(--color-signal-soft)] border border-[var(--color-signal-line)] flex items-center justify-center text-[var(--color-signal)]">
              <Fragment set:html={d.icon} />
            </div>
            <span class="font-mono text-[10px] tracking-[0.15em] text-[var(--color-ink-faint)]">{d.num}</span>
          </div>
          <div>
            <h3 class="font-display text-[1.2rem] text-[var(--color-ink)] leading-[1.25] mb-2">{d.name}</h3>
            <p class="text-[13.5px] text-[var(--color-ink-dim)] font-light leading-[1.7]">{d.summary}</p>
          </div>
          <div class="flex flex-wrap gap-2 mt-auto pt-4 border-t border-[var(--color-hairline)]">
            {d.tags.map((t) => (
              <span class="font-mono text-[9.5px] tracking-[0.04em] text-[var(--color-ink-faint)] bg-white/[0.03] border border-[var(--color-hairline)] px-2.5 py-1 rounded-[3px]">{t}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ENGAGEMENT FORMATS -->
  <section class="px-6 lg:px-10 py-20 border-t border-[var(--color-hairline)] bg-[var(--color-void)]/60">
    <div class="mx-auto max-w-[1200px]">
      <div class="eyebrow mb-4"><span class="kicker-line"></span>How We Engage</div>
      <h2 class="font-display text-[clamp(1.8rem,2.6vw,2.4rem)] text-[var(--color-ink)] mb-12 leading-[1.2]">Formats that match how you actually invest.</h2>
      <div class="grid md:grid-cols-2 gap-4">
        {formats.map((f) => (
          <div class="glass glass-hover rounded-[6px] p-7">
            <h3 class="font-display text-[1.1rem] text-[var(--color-ink)] mb-2">{f.title}</h3>
            <p class="text-[13.5px] text-[var(--color-ink-dim)] font-light leading-[1.7]">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="px-6 lg:px-10 py-24 text-center">
    <div class="mx-auto max-w-[600px]">
      <div class="eyebrow mb-4 justify-center flex"><span class="kicker-line"></span>Get Started</div>
      <h2 class="font-display text-[clamp(1.6rem,2.6vw,2.1rem)] text-[var(--color-ink)] mb-4 leading-[1.3]">Ready for an independent read?</h2>
      <p class="text-[14.5px] text-[var(--color-ink-dim)] font-light leading-[1.8] mb-8">
        Tell us about the asset and the decision ahead. We'll follow up within one business day.
      </p>
      <a href="/contact" class="inline-block font-mono text-[11px] tracking-[0.12em] uppercase px-8 py-4 rounded-[3px] bg-[var(--color-signal)] text-[#04211c] font-medium hover:brightness-110 transition">
        Request a Briefing
      </a>
    </div>
  </section>
</Layout>
