---
import Layout from "../layouts/Layout.astro";
import TickerBar from "../components/TickerBar.astro";

const pillars = [
  {
    num: "01",
    title: "Clinical Probability of Success",
    desc: "An independent read on the likelihood a trial reads out positively — grounded in mechanism, endpoint choice, comparator data, and how the agency has actually treated similar programs.",
    tag: "Clinical PoS",
  },
  {
    num: "02",
    title: "Technical Feasibility",
    desc: "Whether the science and the manufacturing can actually deliver what the deck promises — vector, payload, delivery, and process risk mapped directly to investment risk.",
    tag: "Technical Feasibility",
  },
  {
    num: "03",
    title: "Financial & Commercial Outlook",
    desc: "What a credible approval and launch actually look like — addressable population, pricing and reimbursement reality, and the capital required to get there.",
    tag: "Financial Outlook",
  },
];

const audiences = [
  "Hedge Funds",
  "Venture Capital",
  "Crossover & Long-Only Funds",
  "Family Offices",
  "Special Situations Desks",
  "LP Advisory Committees",
];

const steps = [
  { num: "01", title: "Intake", desc: "Send us the asset, ticker, or program and the decision in front of you." },
  { num: "02", title: "Independent Read", desc: "We assess the science, data package, and regulatory record — without sitting in on management's narrative first." },
  { num: "03", title: "Plain-English Memo", desc: "A structured read across clinical, technical, and financial dimensions — built for an investment committee, not a journal club." },
  { num: "04", title: "Stay Engaged", desc: "Available for follow-up questions, catalyst updates, and a second opinion as new data emerges." },
];

// Illustrative diligence panel — spider chart data points
const radarDimensions = [
  { label: "Clinical PoS",        value: 46,  angle: -90  },
  { label: "CMC Readiness",       value: 78,  angle: -18  },
  { label: "Regulatory Clarity",  value: 62,  angle: 54   },
  { label: "Commercial Outlook",  value: 33,  angle: 126  },
  { label: "Capital Adequacy",    value: 55,  angle: 198  },
];

// Build SVG polygon points for the radar
function polarToXY(angleDeg: number, radius: number, cx = 110, cy = 110) {
  const rad = (angleDeg - 90) * (Math.PI / 180);
  return { x: cx + radius * Math.cos(rad), y: cy + radius * Math.sin(rad) };
}

const maxR = 80;
const cx = 110; const cy = 110;
const gridLevels = [0.25, 0.5, 0.75, 1.0];

const outerPoints = radarDimensions.map(d => polarToXY(d.angle, maxR, cx, cy));
const dataPoints  = radarDimensions.map(d => polarToXY(d.angle, (d.value / 100) * maxR, cx, cy));
const outerPoly   = outerPoints.map(p => `${p.x},${p.y}`).join(" ");
const dataPoly    = dataPoints.map(p =>  `${p.x},${p.y}`).join(" ");

// Signal color fills per dimension
const dimensionColors = ["#34e0c4", "#f3a953", "#34e0c4", "#9bacc9", "#f3a953"];
---
<Layout title="Biotechnology Investment Diligence">
  <!-- HERO -->
  <section class="relative px-6 lg:px-10 pt-16 pb-24 lg:pt-24 lg:pb-32 overflow-hidden">
    <div class="mx-auto max-w-[1200px] grid lg:grid-cols-[1.05fr_0.95fr] gap-16 items-start">
      <div class="rise">
        <div class="eyebrow mb-6"><span class="kicker-line"></span>Biotechnology Investment Diligence</div>
        <h1 class="font-display font-normal text-[clamp(2.4rem,4.6vw,3.85rem)] leading-[1.08] text-[var(--color-ink)] mb-6">
          Know what the science<br/>actually says <em class="italic text-[var(--color-ink-dim)]">before</em><br/>you size the position.
        </h1>
        <p class="text-[16px] text-[var(--color-ink-dim)] font-light leading-[1.8] max-w-[460px] mb-9">
          Polovina Scientific Advisory gives hedge funds and venture investors an independent
          read on clinical probability, technical feasibility, and commercial outlook for
          biotechnology assets — out of the jargon, into a thesis you can act on.
        </p>
        <div class="flex flex-wrap gap-4 mb-12">
          <a href="/contact" class="font-mono text-[11px] tracking-[0.12em] uppercase px-7 py-4 rounded-[3px] bg-[var(--color-signal)] text-[#04211c] font-medium hover:brightness-110 transition">
            Request a Briefing
          </a>
          <a href="/capabilities" class="font-mono text-[11px] tracking-[0.12em] uppercase px-7 py-4 rounded-[3px] border border-[var(--color-hairline-bright)] text-[var(--color-ink)] hover:border-[var(--color-signal-line)] hover:text-[var(--color-signal)] transition">
            See Our Capabilities
          </a>
        </div>
        <div class="flex gap-8 sm:gap-10">
          <div class="max-w-[120px]"><div class="font-display text-[2rem] text-[var(--color-ink)]">3</div><div class="font-mono text-[10px] tracking-[0.12em] uppercase text-[var(--color-ink-faint)] mt-1 leading-[1.5]">Diligence Disciplines</div></div>
          <div class="max-w-[120px]"><div class="font-display text-[2rem] text-[var(--color-ink)]">0</div><div class="font-mono text-[10px] tracking-[0.12em] uppercase text-[var(--color-ink-faint)] mt-1 leading-[1.5]">Vendor / Platform Ties</div></div>
          <div class="max-w-[140px]"><div class="font-display text-[2rem] text-[var(--color-ink)]">1</div><div class="font-mono text-[10px] tracking-[0.12em] uppercase text-[var(--color-ink-faint)] mt-1 leading-[1.5]">Point of Contact</div></div>
        </div>
      </div>

      <!-- REWORKED ILLUSTRATION: radar / spider chart diligence panel -->
      <div class="rise relative lg:translate-x-6 lg:mt-10" style="animation-delay: 0.15s">
        <div class="glass rounded-[8px] p-7 relative overflow-hidden">

          <!-- header -->
          <div class="flex items-center justify-between mb-5">
            <span class="font-mono text-[10px] tracking-[0.16em] uppercase text-[var(--color-ink-dim)]">Program Assessment</span>
            <span class="flex items-center gap-1.5 font-mono text-[9px] tracking-[0.1em] uppercase text-[var(--color-signal)]">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-signal)] pulse-dot"></span>Illustrative
            </span>
          </div>

          <!-- asset label -->
          <div class="mb-5 flex items-center gap-3">
            <div class="w-8 h-8 rounded-[4px] bg-[var(--color-signal-soft)] border border-[var(--color-signal-line)] flex items-center justify-center font-mono text-[9px] text-[var(--color-signal)] tracking-wider">GTx</div>
            <div>
              <div class="font-display text-[13px] text-[var(--color-ink)]">Gene Therapy Program · Rare Disease</div>
              <div class="font-mono text-[9px] text-[var(--color-ink-faint)] tracking-wider uppercase mt-0.5">Phase I/II · IND Active</div>
            </div>
          </div>

          <!-- radar chart -->
          <div class="flex justify-center mb-5">
            <svg viewBox="0 0 220 220" width="200" height="200" class="overflow-visible">
              <!-- grid rings -->
              {gridLevels.map((lvl) => {
                const pts = radarDimensions.map(d => {
                  const p = polarToXY(d.angle, lvl * maxR, cx, cy);
                  return `${p.x},${p.y}`;
                }).join(" ");
                return <polygon points={pts} fill="none" stroke="rgba(151,196,214,0.12)" stroke-width="1" />;
              })}

              <!-- axis lines -->
              {radarDimensions.map((d) => {
                const outer = polarToXY(d.angle, maxR, cx, cy);
                return <line x1={cx} y1={cy} x2={outer.x} y2={outer.y} stroke="rgba(151,196,214,0.15)" stroke-width="1" />;
              })}

              <!-- data polygon fill -->
              <polygon points={dataPoly} fill="rgba(52,224,196,0.08)" stroke="rgba(52,224,196,0.5)" stroke-width="1.5" stroke-linejoin="round" />

              <!-- data point dots -->
              {dataPoints.map((p, i) => (
                <circle cx={p.x} cy={p.y} r="3.5" fill={dimensionColors[i]} opacity="0.9" />
              ))}

              <!-- axis labels -->
              {radarDimensions.map((d) => {
                const labelR = maxR + 18;
                const lp = polarToXY(d.angle, labelR, cx, cy);
                const anchor = lp.x < cx - 5 ? "end" : lp.x > cx + 5 ? "start" : "middle";
                return (
                  <text
                    x={lp.x} y={lp.y + 3}
                    text-anchor={anchor}
                    font-family="Martian Mono, DM Mono, monospace"
                    font-size="7.5"
                    fill="rgba(155,172,201,0.75)"
                    letter-spacing="0.04em"
                  >{d.label}</text>
                );
              })}
            </svg>
          </div>

          <!-- dimension score bars -->
          <div class="flex flex-col gap-2.5 pt-4 border-t border-[var(--color-hairline)]">
            {radarDimensions.map((d, i) => (
              <div class="flex items-center gap-3">
                <span class="font-mono text-[9px] tracking-[0.06em] text-[var(--color-ink-faint)] w-[110px] shrink-0">{d.label}</span>
                <div class="flex-1 h-1 rounded-full bg-white/[0.05] overflow-hidden">
                  <div class="h-full rounded-full" style={`width: ${d.value}%; background: ${dimensionColors[i]}; opacity: 0.75`}></div>
                </div>
                <span class="font-mono text-[9px] text-[var(--color-ink-faint)] w-8 text-right">{d.value}</span>
              </div>
            ))}
          </div>

          <p class="mt-4 text-[11px] text-[var(--color-ink-faint)] leading-relaxed">
            Sample structure only — every read is built around the specific asset, endpoints, and decision in front of you.
          </p>
        </div>
        <div class="absolute -bottom-5 -left-5 w-24 h-24 rounded-[6px] border border-[var(--color-hairline)] -z-10 hidden lg:block"></div>
      </div>
    </div>
  </section>

  <!-- TICKER BAR -->
  <TickerBar />

  <div class="divider mx-6 lg:mx-10 border-t border-[var(--color-hairline)]"></div>

  <!-- THREE PILLARS -->
  <section class="px-6 lg:px-10 py-24">
    <div class="mx-auto max-w-[1200px]">
      <div class="max-w-[560px] mb-14">
        <div class="eyebrow mb-4"><span class="kicker-line"></span>What We Evaluate</div>
        <h2 class="font-display text-[clamp(1.8rem,2.6vw,2.4rem)] text-[var(--color-ink)] leading-[1.2]">
          Three questions every position comes down to.
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-5">
        {pillars.map((p) => (
          <a href="/capabilities" class="glass glass-hover rounded-[6px] p-7 flex flex-col">
            <div class="font-mono text-[10px] tracking-[0.15em] text-[var(--color-ink-faint)] mb-5">{p.num}</div>
            <h3 class="font-display text-[1.25rem] text-[var(--color-ink)] mb-3 leading-snug">{p.title}</h3>
            <p class="text-[13.5px] text-[var(--color-ink-dim)] font-light leading-[1.7] flex-1">{p.desc}</p>
            <span class="font-mono text-[10px] tracking-[0.1em] uppercase text-[var(--color-signal)] mt-5">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- WHO WE SERVE -->
  <section class="px-6 lg:px-10 py-16 border-y border-[var(--color-hairline)] bg-[var(--color-void)]/60">
    <div class="mx-auto max-w-[1200px]">
      <div class="font-mono text-[10px] tracking-[0.18em] uppercase text-[var(--color-ink-faint)] text-center mb-9">
        Built for capital allocators evaluating biotechnology exposure
      </div>
      <div class="flex flex-wrap justify-center gap-x-12 gap-y-5">
        {audiences.map((a) => (
          <span class="font-display text-[1.05rem] text-[var(--color-ink-faint)] hover:text-[var(--color-ink-dim)] transition-colors">{a}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="px-6 lg:px-10 py-24">
    <div class="mx-auto max-w-[1200px]">
      <div class="eyebrow mb-4"><span class="kicker-line"></span>How It Works</div>
      <h2 class="font-display text-[clamp(1.8rem,2.6vw,2.4rem)] text-[var(--color-ink)] mb-12 leading-[1.2]">A short path from question to thesis.</h2>
      <div class="grid md:grid-cols-4 gap-px bg-[var(--color-hairline)] rounded-[6px] overflow-hidden">
        {steps.map((s) => (
          <div class="bg-[var(--color-void)] p-7">
            <div class="font-display text-[2.4rem] text-[var(--color-ink-faint)]/30 mb-3 leading-none">{s.num}</div>
            <div class="font-display text-[1.05rem] text-[var(--color-ink)] mb-2">{s.title}</div>
            <p class="text-[13px] text-[var(--color-ink-dim)] font-light leading-[1.65]">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="px-6 lg:px-10 py-24">
    <div class="mx-auto max-w-[760px] glass rounded-[8px] px-10 py-14 text-center">
      <h2 class="font-display text-[clamp(1.6rem,2.6vw,2.1rem)] text-[var(--color-ink)] mb-4 leading-[1.3]">
        Considering a position in a biotech name?
      </h2>
      <p class="text-[14.5px] text-[var(--color-ink-dim)] font-light leading-[1.8] max-w-[480px] mx-auto mb-8">
        Send us the asset and the decision in front of you. We'll tell you honestly what the science supports — and what it doesn't.
      </p>
      <a href="/contact" class="inline-block font-mono text-[11px] tracking-[0.12em] uppercase px-8 py-4 rounded-[3px] bg-[var(--color-signal)] text-[#04211c] font-medium hover:brightness-110 transition">
        Request a Briefing
      </a>
    </div>
  </section>
</Layout>
